{
  "name": "restful-booker-api-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API automation framework for Restful-Booker using Playwright APIRequestContext",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests",
    "test:api:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "report:html": "playwright show-report playwright-report",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.64.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.3",
    "dotenv": "^16.6.1",
    "eslint": "^10.14.0",
    "globals": "^16.5.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
